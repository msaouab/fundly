# Neon — Dashboard → your project → Connect → copy the connection string
# Prefer the pooled URL for serverless (ends with .pooler.neon.tech when offered).
# Use verify-full explicitly (pg v8+ deprecates ambiguous sslmode=require; see lib/pg-connection-string.ts).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full"

# Auth.js — run: openssl rand -base64 32
AUTH_SECRET=""
