generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IncomeType {
  SALARY
  FREELANCE
  PASSIVE
  BONUS
  OTHER
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum ExpenseKind {
  FIXED
  VARIABLE
}

enum ExpenseCategory {
  HOUSING
  FOOD_GROCERIES
  TRANSPORT
  UTILITIES
  HEALTH
  ENTERTAINMENT
  SHOPPING
  SUBSCRIPTIONS
  EDUCATION
  TRAVEL
  DONATIONS
  SAVINGS_CONTRIBUTION
  OTHER
}

enum GoalType {
  CAR
  HOUSE
  VACATION
  EMERGENCY_FUND
  EDUCATION
  WEDDING
  DEVICE
  OTHER
}

enum SimType {
  SAVINGS_GOAL
  LOAN
  DEBT_PAYOFF
  WHAT_IF
  NET_WORTH
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String        @map("password_hash")
  name         String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  incomes      Income[]
  expenses     Expense[]
  goals        Goal[]
  simulations  Simulation[]

  @@map("users")
}

model Goal {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  emoji          String       @default("🎯")
  type           GoalType
  targetAmount   Decimal      @db.Decimal(12, 2) @map("target_amount")
  savedAmount    Decimal      @default(0) @db.Decimal(12, 2) @map("saved_amount")
  monthlyContrib Decimal      @db.Decimal(12, 2) @map("monthly_contrib")
  interestRate   Decimal      @default(0) @db.Decimal(5, 2) @map("interest_rate")
  deadline       DateTime?    @map("deadline")
  currency       String       @default("MAD")
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  simulations    Simulation[]

  @@index([userId])
  @@map("goals")
}

model Simulation {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId     String?  @map("goal_id")
  goal       Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  type       SimType
  name       String
  configJson Json     @map("config_json")
  resultJson Json     @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("simulations")
}

model Income {
  id                  String               @id @default(cuid())
  userId              String               @map("user_id")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  source              String
  type                IncomeType
  amount              Decimal              @db.Decimal(12, 2)
  date                DateTime
  currency            String               @default("MAD")
  isRecurring         Boolean              @default(false) @map("is_recurring")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  payee               String?
  note                String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([date])
  @@map("incomes")
}

model Expense {
  id                  String               @id @default(cuid())
  userId              String               @map("user_id")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  description         String               @default("")
  kind                ExpenseKind          @default(VARIABLE)
  category            ExpenseCategory      @default(OTHER)
  amount              Decimal              @db.Decimal(12, 2)
  date                DateTime
  currency            String               @default("MAD")
  isRecurring         Boolean              @default(false) @map("is_recurring")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  payee               String?
  note                String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([date])
  @@index([kind])
  @@index([category])
  @@map("expenses")
}

