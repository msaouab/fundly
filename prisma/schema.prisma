generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IncomeType {
  SALARY
  FREELANCE
  PASSIVE
  BONUS
  OTHER
}

enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum ExpenseKind {
  FIXED
  VARIABLE
}

enum ExpenseCategory {
  HOUSING
  FOOD_GROCERIES
  TRANSPORT
  UTILITIES
  HEALTH
  ENTERTAINMENT
  SHOPPING
  SUBSCRIPTIONS
  EDUCATION
  TRAVEL
  DONATIONS
  SAVINGS_CONTRIBUTION
  OTHER
}

enum GoalType {
  CAR
  HOUSE
  VACATION
  EMERGENCY_FUND
  EDUCATION
  WEDDING
  DEVICE
  OTHER
}

enum SimType {
  SAVINGS_GOAL
  LOAN
  DEBT_PAYOFF
  WHAT_IF
  NET_WORTH
}

enum HolidayType {
  PUBLIC
  RELIGIOUS
  OBSERVANCE
}

enum PlannedEventCategory {
  HOLIDAY
  TRAVEL
  FAMILY
  WEDDING
  EDUCATION
  SHOPPING
  OTHER
}

enum PlannedEventStatus {
  PLANNING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum YearlyEventKind {
  BIRTHDAY
  ANNIVERSARY
  OTHER
}

enum YearlyEventRelation {
  SELF
  SPOUSE
  CHILD
  PARENT
  SIBLING
  FRIEND
  OTHER
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  name          String?
  countryCode   String         @default("MA") @map("country_code")
  currency      String         @default("MAD")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  incomes       Income[]
  expenses      Expense[]
  goals         Goal[]
  simulations   Simulation[]
  plannedEvents PlannedEvent[]
  yearlyEvents  YearlyEvent[]

  @@map("users")
}

model Holiday {
  id          String      @id @default(cuid())
  countryCode String      @map("country_code")
  date        DateTime
  name        String
  type        HolidayType @default(PUBLIC)
  slug        String?
  plannedEvents PlannedEvent[]

  @@unique([countryCode, date, name])
  @@index([countryCode, date])
  @@map("holidays")
}

model PlannedEvent {
  id              String               @id @default(cuid())
  userId          String               @map("user_id")
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        PlannedEventCategory @default(OTHER)
  status          PlannedEventStatus   @default(PLANNING)
  startDate       DateTime             @map("start_date")
  endDate         DateTime?            @map("end_date")
  budgetAmount    Decimal              @db.Decimal(12, 2) @map("budget_amount")
  reservedAmount  Decimal              @default(0) @db.Decimal(12, 2) @map("reserved_amount")
  currency        String               @default("MAD")
  sourceHolidayId String?              @map("source_holiday_id")
  sourceHoliday   Holiday?             @relation(fields: [sourceHolidayId], references: [id], onDelete: SetNull)
  goalId          String?              @map("goal_id")
  goal            Goal?                @relation(fields: [goalId], references: [id], onDelete: SetNull)
  completedAt     DateTime?            @map("completed_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  expenses        Expense[]

  @@index([userId])
  @@index([userId, startDate])
  @@index([status])
  @@map("planned_events")
}

model YearlyEvent {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  kind        YearlyEventKind     @default(BIRTHDAY)
  relation    YearlyEventRelation @default(OTHER)
  month       Int
  day         Int
  birthYear   Int?                @map("birth_year")
  giftBudget  Decimal?            @db.Decimal(12, 2) @map("gift_budget")
  currency    String              @default("MAD")
  notes       String?
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, month, day])
  @@map("yearly_events")
}

model Goal {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  emoji          String         @default("🎯")
  type           GoalType
  targetAmount   Decimal        @db.Decimal(12, 2) @map("target_amount")
  savedAmount    Decimal        @default(0) @db.Decimal(12, 2) @map("saved_amount")
  monthlyContrib Decimal        @db.Decimal(12, 2) @map("monthly_contrib")
  interestRate   Decimal        @default(0) @db.Decimal(5, 2) @map("interest_rate")
  deadline       DateTime?      @map("deadline")
  currency       String         @default("MAD")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  simulations    Simulation[]
  plannedEvents  PlannedEvent[]

  @@index([userId])
  @@map("goals")
}

model Simulation {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId     String?  @map("goal_id")
  goal       Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  type       SimType
  name       String
  configJson Json     @map("config_json")
  resultJson Json     @map("result_json")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("simulations")
}

model Income {
  id                  String               @id @default(cuid())
  userId              String               @map("user_id")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  source              String
  type                IncomeType
  amount              Decimal              @db.Decimal(12, 2)
  date                DateTime
  currency            String               @default("MAD")
  isRecurring         Boolean              @default(false) @map("is_recurring")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  payee               Boolean              @default(false)
  note                String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([date])
  @@map("incomes")
}

model Expense {
  id                  String               @id @default(cuid())
  userId              String               @map("user_id")
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedEventId      String?              @map("planned_event_id")
  plannedEvent        PlannedEvent?        @relation(fields: [plannedEventId], references: [id], onDelete: SetNull)
  description         String               @default("")
  kind                ExpenseKind          @default(VARIABLE)
  category            ExpenseCategory      @default(OTHER)
  amount              Decimal              @db.Decimal(12, 2)
  date                DateTime
  currency            String               @default("MAD")
  isRecurring         Boolean              @default(false) @map("is_recurring")
  recurrenceFrequency RecurrenceFrequency? @map("recurrence_frequency")
  payee               Boolean              @default(false)
  note                String?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")

  @@index([userId])
  @@index([date])
  @@index([plannedEventId])
  @@index([kind])
  @@index([category])
  @@map("expenses")
}
